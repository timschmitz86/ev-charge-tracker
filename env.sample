# Core configuration
ASPNETCORE_ENVIRONMENT=Production
DATA_FILE_PATH=/app/data/data.json

# Vehicle integration
VEHICLE_INTEGRATION_ENABLED=true
VEHICLE_INTEGRATION_PROVIDER=remote
VEHICLE_INTEGRATION_BASE_URL=http://vehicle-service:8100
SKODA_CONNECT_BASE_URL=https://public.api.connect.skoda-auto.cz
SKODA_CONNECT_API_KEY=YOUR_KEY
SKODA_CONNECT_VIN=YOUR_VIN

# Vehicle service env file (contains provider credentials)
VEHICLE_SERVICE_ENV_FILE=./vehicle-service/.env

# Traefik (used by docker-compose.prod.yml)
TRAEFIK_ENABLE=true
TRAEFIK_HOST=example.com
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true
TRAEFIK_NETWORK=traefik
TRAEFIK_MIDDLEWARES=carcharge-headers@docker
