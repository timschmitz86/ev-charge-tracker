# Vehicle Integration Configuration
# ----------------------------------
# Provider type: skoda | (future: bmw, tesla, volkswagen)
VEHICLE_PROVIDER=skoda

# Skoda Connect / MySkoda credentials
SKODA_USERNAME=your-email@example.com
SKODA_PASSWORD=your-password

# Vehicle Identification Number
VEHICLE_VIN=TMBJB9NY1RF123456

# Optional: Map a friendly vehicle ID to VIN (comma-separated pairs)
# Format: friendlyId=VIN,friendlyId2=VIN2
VEHICLE_MAP=car1=TMBJB9NY1RF123456
